PRIMARY_SERVICE, GAP_SERVICE
// Games look for this name, same as the official Konami BLE controller
CHARACTERISTIC, GAP_DEVICE_NAME, READ, "IIDX Entry model"

// Konami's own service, not HID: one characteristic, the controller notifies
// its input frames on it, see bt.c
PRIMARY_SERVICE, FF00
CHARACTERISTIC, FF01, DYNAMIC | READ | WRITE | NOTIFY,
