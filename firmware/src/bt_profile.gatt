PRIMARY_SERVICE, GAP_SERVICE
// Same name as the USB Konami spoof, see switch_to_konami_mode()
CHARACTERISTIC, GAP_DEVICE_NAME, READ, "beatmania IIDX controller premium model"
// 0x03C4: HID Gamepad
CHARACTERISTIC, GAP_APPEARANCE, READ, C4 03
// Preferred connection: 11.25ms to 15ms (9, 12), latency 0, timeout 4s (400)
CHARACTERISTIC, GAP_PERIPHERAL_PREFERRED_CONNECTION_PARAMETERS, READ, 09 00 0C 00 00 00 90 01

PRIMARY_SERVICE, ORG_BLUETOOTH_SERVICE_DEVICE_INFORMATION
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_MANUFACTURER_NAME_STRING, READ, "Konami Amusement"
// Vendor ID source 2 (USB-IF), VID 0x1ccf, PID 0x8048, version 0x0100, the
// same ids as the USB Konami spoof, see switch_to_konami_mode()
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_PNP_ID, READ, 02 CF 1C 48 80 00 01

// Human Interface Device, the characteristics are picked up by hids_device.c
PRIMARY_SERVICE, ORG_BLUETOOTH_SERVICE_HUMAN_INTERFACE_DEVICE
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT_MAP, DYNAMIC | READ,
// bcdHID 0x0101, country code 0, normally connectable
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_HID_INFORMATION, READ, 01 01 00 02
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_HID_CONTROL_POINT, DYNAMIC | WRITE_WITHOUT_RESPONSE,

CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT, DYNAMIC | READ | NOTIFY | ENCRYPTION_KEY_SIZE_16,
// fixed report id = 1 (REPORT_ID_JOYSTICK), type = Input (1)
REPORT_REFERENCE, READ, 1, 1

CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT, DYNAMIC | READ | WRITE | WRITE_WITHOUT_RESPONSE | ENCRYPTION_KEY_SIZE_16,
// fixed report id = 2 (REPORT_ID_LIGHTS), type = Output (2)
REPORT_REFERENCE, READ, 2, 2
